type ILoggerMessageArg = string | Error | (() => string | Error);
type ILoggerMethod = (message: ILoggerMessageArg, ...args: any[]) => void;
/**
 * 日志记录器接口
 *
 * 提供 debug / info / warn / error 四个级别的日志方法，
 * 每个方法接收一条消息（或 Error）与可变参数列表。
 */
type ILogger = {
    debug: ILoggerMethod;
    info: ILoggerMethod;
    warn: ILoggerMethod;
    error: ILoggerMethod;
};
type ILoggerOptions = {
    template?: string;
    debug?: boolean;
    vars?: Record<string, any>;
    colorized?: boolean;
};
/**
 * 创建一个日志记录器。
 *
 * @param options.debug 是否开启调试模式（输出 debug / info 级别日志）
 * @returns 符合 {@link ILogger} 的日志记录器
 */
declare function createLogger(options?: ILoggerOptions): ILogger;

export { type ILogger, type ILoggerMessageArg, type ILoggerMethod, type ILoggerOptions, createLogger };
