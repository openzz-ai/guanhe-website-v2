declare class TimeoutError extends Error {
    constructor();
}
/**
 * 包装异步函数，使之具备超时能力,当超时时会触发TIMEOUT错误
 * 当执行超过times时会触发异常
 * @param fn
 * @param options {value:<超时值>,default:<超时返回的均默认值>}
 * @return {function(): unknown}
 */
declare function timeout(fn: AsyncFunction, options?: {
    value?: number;
    default?: any;
}): AsyncFunction;

export { TimeoutError, timeout };
