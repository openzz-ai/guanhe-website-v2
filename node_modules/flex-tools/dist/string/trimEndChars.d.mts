declare global {
    interface String {
        trimEndChars(chars: string, atEnd?: boolean): string;
    }
}
/**
 * 截断字符串未尾的字符
 *
 * "abc123xyz".trimEndChars("xyz") == "abc123"
 *
 *
 * @param chars
 * @returns {string}
 */
declare function trimEndChars(str: string, chars: string, atEnd?: boolean): string;

export { trimEndChars };
