/**
 * 移除字符串前后的字符
 *
 * trimChars(" hello world  ") => "hello world"
 * trimChars(" \nhello world\n ") => "hello world"
 *
 * @param {*} str
 * @param {*} chars
 * @returns
 */
declare function trimChars(str: string, chars?: string): string;
declare global {
    interface String {
        trimChars(chars: string): string;
    }
}

export { trimChars };
